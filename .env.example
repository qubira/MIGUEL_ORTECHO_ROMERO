# --- Base de datos (Neon) ---
# Copia la "Connection string" (pooled) desde el dashboard de Neon.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- NextAuth ---
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-por-un-valor-aleatorio-largo"
# URL pública del sitio (en Vercel: https://tu-proyecto.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# --- Usuario administrador inicial (usado por "npm run seed") ---
ADMIN_NAME="Miguel Ortecho Romero"
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="CambiaEstaClave123!"
